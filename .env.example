# Browser API calls use the same-origin /api/backend BFF. Configure this server-only URL in normal deployments.
BACKEND_API_URL=http://localhost:8080
# Optional legacy/server fallback; the public /upload page does not require a browser-visible backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Customer-facing payment QR. Use merchant-static for a bank-issued static Bill Payment / Merchant QR.
NEXT_PUBLIC_PAYMENT_QR_MODE=merchant-static
NEXT_PUBLIC_PAYMENT_QR_PAYLOAD=replace-with-raw-emv-qr-payload
NEXT_PUBLIC_PAYMENT_QR_DISPLAY_NAME=replace-with-public-business-display-name
NEXT_PUBLIC_PAYMENT_QR_DISPLAY_IDENTIFIER=QR ร้านค้า

# Legacy/generated PromptPay mode. Used when NEXT_PUBLIC_PAYMENT_QR_MODE is not merchant-static.
NEXT_PUBLIC_PROMPTPAY_ID=replace-with-promptpay-id
NEXT_PUBLIC_PROMPTPAY_DISPLAY_NAME=replace-with-public-business-display-name

