{
  "name": "glossy-design",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "npm run check:utf8",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:e2e:browser": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "check:utf8": "node scripts/check-utf8.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@line/liff": "^2.30.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/x-date-pickers": "^9.11.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.23.12",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.16.0",
    "next": "^16.3.0",
    "promptpay-qr": "^0.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.1.2",
    "styled-components": "^6.1.19",
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
